# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# NAMES ONLY IN THIS FILE, NEVER VALUES. A placeholder that looks like a real
# credential is how a secret scanner gets trained to ignore the real one.
#
# The prefix is set by `env_prefix` in src/fast_mcp_template/config.py and is
# spelled out in exactly those two places.

MCP_TEMPLATE_GREETING=hello

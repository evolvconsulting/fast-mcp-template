{
  "family": "fast-mcp-template",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::000000000000:role/fast-mcp-template-execution-role",
  "taskRoleArn": "arn:aws:iam::000000000000:role/fast-mcp-template-task-role",
  "containerDefinitions": [
    {
      "name": "fast-mcp-template",
      "image": "000000000000.dkr.ecr.us-east-2.amazonaws.com/fast-mcp-template:REPLACED_AT_DEPLOY_BY_CI",
      "essential": true,
      "stopTimeout": 35,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fast-mcp-template",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [],
      "secrets": []
    }
  ]
}

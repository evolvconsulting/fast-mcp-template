{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrReadThisRepositoryOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-2:000000000000:repository/fast-mcp-template"
    },
    {
      "Sid": "RegisterTaskDefinitionCannotBeResourceScoped",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "ReadTaskDefinitionCannotBeResourceScoped",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "UpdateOnlyThisService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:us-east-2:000000000000:service/CLUSTER/fast-mcp-template"
    },
    {
      "Sid": "PassOnlyThisServicesEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::000000000000:role/fast-mcp-template-execution-role",
        "arn:aws:iam::000000000000:role/fast-mcp-template-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPerUserDownstreamCredentialsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-2:000000000000:secret:mcp/users/*/template-??????"
    },
    {
      "Sid": "KmsDecryptViaSecretsManagerOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-2:000000000000:key/KMS_KEY_ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-2.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:us-east-2:000000000000:secret:mcp/users/*/template-??????"
        }
      }
    }
  ]
}
